# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
# Everything is optional: without these the site runs on its built-in data, bookings go by WhatsApp only,
# and no analytics are sent.

# Supabase (database + /admin login). Project Settings → API Keys.
# Use the PUBLISHABLE key (sb_publishable_…). Never put the secret key (sb_secret_…) here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
VITE_GA_ID=

# Meta (Facebook/Instagram) Pixel ID, digits only
VITE_META_PIXEL_ID=
