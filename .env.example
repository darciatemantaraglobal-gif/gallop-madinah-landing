# Copy to .env.local for local development; set the same names in Vercel → Settings → Environment Variables.
# Everything is optional: without these the site runs on its built-in data and sends no analytics.

# Google Sheet API: the /exec URL of the Apps Script web app (see apps-script/README.md)
VITE_SHEET_API_URL=

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ
VITE_GA_ID=

# Meta (Facebook/Instagram) Pixel ID, digits only
VITE_META_PIXEL_ID=
